# Environment variables for Interview Prep Kit.
# Copy this file to .env.local and fill in real values. Do NOT commit secrets.
#
# MONGODB_URI    - MongoDB connection string used by src/lib/db.ts.
# LLM_PROVIDER   - Name of the LLM provider (owner decides which one).
# LLM_API_KEY    - API key/secret for the chosen LLM provider.
# LLM_MODEL      - Model identifier for the chosen provider.
# SESSION_SECRET - Random string used to sign sessions.

MONGODB_URI=            # MongoDB connection string (MongoDB Atlas free tier)
LLM_PROVIDER=gemini     # "gemini" or "groq"
LLM_API_KEY=            # api key for the chosen provider
LLM_MODEL=              # e.g. gemini-3.6-flash  OR  openai/gpt-oss-120b (groq)
SESSION_SECRET=         # random string for session signing

TAVILY_API_KEY=       # Tavily search API key (free dev tier) for step 3 web search
